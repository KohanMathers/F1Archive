POSTGRES_USER=f1archive
POSTGRES_PASSWORD=change-me
POSTGRES_DB=f1archive
# Where Postgres keeps its data. A named volume by default; for the full archive (~100-150 GB) point this at a big disk, e.g. /srv/f1archive/pgdata
#PGDATA_DIR=/srv/f1archive/pgdata
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE_SIZE=4GB
PG_MAINTENANCE_WORK_MEM=1GB

SOURCE_DB_DIR=./data/dev
SOURCE_DB_FILE=f1-telem-dev.db

RADIO_DIR_HOST=./data/radio
# Allow visitors to download recordings (single clips and per-session zips)
RADIO_DOWNLOADS=true

WEB_PORT=3000
WEB_BIND=0.0.0.0
PUBLIC_BASE_URL=https://f1archive.org
TRUST_PROXY=true
RATE_LIMIT_PER_MINUTE=600

# Generate with: openssl rand -hex 32. Leave empty to turn this off (caches then expire on their own within an hour)
CACHE_CLEAR_TOKEN=

# Different from CACHE_CLEAR_TOKEN. Empty: those endpoints are off.
NOTICE_TOKEN=

EXPORT_CONCURRENCY=1
EXPORT_TTL_HOURS=48
EXPORT_MAX_ROWS=250000000

# Uncomment on a development machine so every `docker compose` command (including `run`) also applies docker-compose.dev.yml. Leave commented in production.
#COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

# When the archive stays on another machine, publish Postgres on the LAN for its importer (docs/DEPLOY.md, "Importing from another machine"):
#COMPOSE_FILE=docker-compose.yml:docker-compose.lan.yml
#POSTGRES_BIND=192.168.1.20
