# The archive on this machine. Only ever read.
SOURCE_DB=/mnt/data/f1-telem.db

# Postgres on the server, published on the LAN by docker-compose.lan.yml.
# User, password and database name are the server's POSTGRES_* values from its .env.
DATABASE_URL=postgres://f1archive:change-me@192.168.1.20:5432/f1archive

# Where the site's web server answers from here, and the server's CACHE_CLEAR_TOKEN, so the site shows the new data straight away. The LAN address and WEB_PORT (http://192.168.1.20:3000) or the public address (https://f1archive.org) both work.
WEB_INTERNAL_URL=http://192.168.1.20:3000
CACHE_CLEAR_TOKEN=
